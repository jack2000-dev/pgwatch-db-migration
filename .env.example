# Monitoring labels (also appear as pgwatch dbname values)
SOURCE_PGWATCH_NAME=publisher-appdb
TARGET_PGWATCH_NAME=subscriber-appdb

# PostgreSQL 17 publisher
SOURCE_DB_HOST=publisher.example.com
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=appdb
SOURCE_DB_USER=pgwatch_monitor
SOURCE_DB_PASSWORD=replace-with-a-long-random-password
SOURCE_DB_SSLROOTCERT_HOST=/absolute/path/to/source-ca.crt

# PostgreSQL 18 subscriber
TARGET_DB_HOST=subscriber.example.com
TARGET_DB_PORT=5432
TARGET_DB_NAME=appdb
TARGET_DB_USER=pgwatch_monitor
TARGET_DB_PASSWORD=replace-with-a-long-random-password
TARGET_DB_SSLROOTCERT_HOST=/absolute/path/to/target-ca.crt

# Private metrics database inside this Compose project
METRICS_DB_NAME=pgwatch_metrics
METRICS_DB_USER=pgwatch
METRICS_DB_PASSWORD=replace-with-a-different-long-random-password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-third-long-random-password
GRAFANA_PORT=3000
PGWATCH_WEB_PORT=8080

# pgwatch retention (PostgreSQL interval syntax)
PGWATCH_RETENTION=30 days
