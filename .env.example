# Shared PostgreSQL password file for every Web UI profile and exact validation.
# Format: hostname:port:database:username:password
# Use exact entries and chmod 600 this file.
DB_PGPASSFILE_HOST=/absolute/path/to/.pgpass

# Directory containing optional CA certificates referenced by Web UI profiles.
# Its files are available inside pgwatch under /run/pgwatch-certs/.
DB_CERTS_DIR_HOST=./secrets/certs

# pgwatch management console. Keep loopback unless protected by VPN + HTTPS.
PGWATCH_WEB_USER=admin
PGWATCH_WEB_PASSWORD=replace-with-a-long-random-password
PGWATCH_WEB_BIND_ADDRESS=127.0.0.1
PGWATCH_WEB_PORT=8080

# Optional one-pair CLI validation settings. Monitoring profiles are managed in
# the pgwatch Web UI; these values are used only by validate.sh and
# validate-data.sh.
SOURCE_DB_HOST=publisher.example.com
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=appdb
SOURCE_DB_USER=pgwatch_monitor
SOURCE_DB_SSLMODE=verify-full
# Required only for verify-ca and verify-full.
SOURCE_DB_SSLROOTCERT_HOST=/absolute/path/to/source-ca.crt

# PostgreSQL subscriber
TARGET_DB_HOST=subscriber.example.com
TARGET_DB_PORT=5432
TARGET_DB_NAME=appdb
TARGET_DB_USER=pgwatch_monitor
TARGET_DB_SSLMODE=verify-full
# Required only for verify-ca and verify-full.
TARGET_DB_SSLROOTCERT_HOST=/absolute/path/to/target-ca.crt

# One-shot exact data validation (separate read-only table access)
SOURCE_PUBLICATION_NAME=replace-with-publication-name
TARGET_SUBSCRIPTION_NAME=replace-with-subscription-name
SOURCE_VALIDATION_DB_USER=migration_validator
TARGET_VALIDATION_DB_USER=migration_validator
VALIDATION_CATCHUP_TIMEOUT_SECONDS=300
# Must match the migration_pair custom tag; defaults to SOURCE_DB_NAME when empty.
VALIDATION_MIGRATION_PAIR=appdb-migration

# Private pgwatch databases inside this Compose project
CONFIG_DB_NAME=pgwatch_config
METRICS_DB_NAME=pgwatch_metrics
METRICS_DB_USER=pgwatch
METRICS_DB_PASSWORD=replace-with-a-different-long-random-password

# Grafana
GRAFANA_ADMIN_USER=admin
# Keep loopback unless port 3000 is restricted to trusted VPN/client addresses.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_PASSWORD=replace-with-a-third-long-random-password
GRAFANA_PORT=3000

# pgwatch retention (PostgreSQL interval syntax)
PGWATCH_RETENTION='30 days'
